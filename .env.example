# Copy to .env for local development. On Vercel, add these in
# Project > Settings > Environment Variables (Production + Preview), then redeploy.
# Never commit real values. .env is already in .gitignore.

# ---------- REQUIRED ----------

# PostgreSQL connection string. Use your provider's POOLED URL for serverless.
#   Neon (recommended, free tier, one click from Vercel > Storage > Neon): sets DATABASE_URL for you
#   Supabase: Project Settings > Database > Connection pooling (port 6543); also set DATABASE_SSL=no-verify
# IMPORTANT: copy the URL with the provider's copy button — never retype the password.
# Passwords containing @ # / ? % break the URL if typed by hand, and cause
# "password authentication failed for user postgres" (28P01). On Supabase the pooler
# user must be postgres.<project-ref>, not just postgres. After changing this on
# Vercel you must Redeploy for it to take effect. Test locally with: npm run check-db
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Signs login sessions. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
JWT_SECRET=

# Google Gemini key for leaf assessment and the assistant (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Public address of the site, used in links inside emails (no trailing slash)
APP_URL=https://your-project.vercel.app

# The account registered with this email becomes the FIRST administrator
# (only while no administrator exists). Register with it right after deploying.
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# ---------- EMAIL (required for notifications) ----------
# Option A: any SMTP provider (Brevo, Resend, SendGrid, Mailgun, Zoho, Outlook…)
#   Resend:  SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key>
#   Brevo:   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASS=<SMTP key>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Must be an address/domain your provider has verified
EMAIL_FROM=ArmywormGuard <alerts@yourdomain.org>

# Option B: a Gmail account with 2-Step Verification + an app password
# (fine for a pilot; Gmail limits you to ~500 emails/day). Used only if SMTP_HOST is empty.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---------- OPTIONAL ----------
# Gemini models to try, in order
GEMINI_MODELS=
# Telegram: lets farmers send a result to their Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
# disable | no-verify | strict   (only if your database provider needs it)
#   no-verify  Supabase's pooler: its certificate chain is not trusted by Node (SELF_SIGNED_CERT_IN_CHAIN).
#              The app also retries once automatically on such an error, so this is mostly for clarity.
#   strict     refuse that automatic retry (verification stays on)
#   disable    no TLS at all (local Postgres only)
# When this is set, any sslmode= parameter in DATABASE_URL is ignored.
DATABASE_SSL=
# connections per serverless instance (default 3)
DATABASE_POOL_MAX=
